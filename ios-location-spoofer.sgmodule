#!name=iOS Location Spoofer (Stateless)
#!desc=自托管固定版本：坐标写入本机持久化存储。适用于 Shadowrocket / Surge / Egern。
#!homepage=https://github.com/TooXu/ios-location-spoofer

[Script]
# 1) 拦截 Apple /clls/wloc 响应。脚本固定到已审查的 Fork commit，避免跟随上游 main 自动变化。
iOS Location Spoofer = type=http-response,pattern=^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc(?:\?.*)?$,requires-body=1,binary-body-mode=1,max-size=1048576,timeout=10,script-path=https://raw.githubusercontent.com/TooXu/ios-location-spoofer/fb0d861729d11e282c968cbf64ddea41d26a5457/location-spoofer.js,argument=mode=response&debug=false
# 2) 拦截选点页的储存请求，把坐标写进本机持久化。
iLS Settings = type=http-request,pattern=^https?:\/\/gs-loc(?:-cn)?\.apple\.com\/ils-settings\/,requires-body=0,max-size=0,timeout=10,script-path=https://raw.githubusercontent.com/TooXu/ios-location-spoofer/fb0d861729d11e282c968cbf64ddea41d26a5457/location-settings.js

[MITM]
hostname = %APPEND% gs-loc.apple.com, gs-loc-cn.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com
